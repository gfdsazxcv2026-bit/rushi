{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://rushi.local/eval/dialogue-suite.schema.json",
  "title":"入史对话验收定义",
  "type":"object",
  "additionalProperties":false,
  "required":["version","title","cases"],
  "properties":{
    "$schema":{"type":"string"},
    "version":{"const":1},
    "title":{"type":"string","minLength":1},
    "priorityCaseIds":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^D[0-9]{2}$"}},
    "cases":{"type":"array","minItems":1,"maxItems":30,"items":{"$ref":"#/$defs/case"}}
  },
  "$defs":{
    "alias":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,30}$"},
    "case":{
      "type":"object","additionalProperties":false,"required":["id","title","manualReview","steps"],
      "properties":{
        "id":{"type":"string","pattern":"^D[0-9]{2}$"},
        "title":{"type":"string","minLength":1},
        "tags":{"type":"array","items":{"type":"string"}},
        "notes":{"type":"string"},
        "manualReview":{"type":"array","items":{"type":"string","minLength":1}},
        "steps":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/step"}}
      }
    },
    "expect":{
      "type":"object","additionalProperties":false,
      "properties":{
        "status":{"type":"integer","minimum":100,"maximum":599},
        "errorCode":{"type":"string"},
        "session":{"type":"object","propertyNames":{"pattern":"^[a-zA-Z0-9_.]+$"}},
        "unchanged":{"type":"array","uniqueItems":true,"items":{"enum":["conditions","events","knowledge","characterStatus","mode"]}},
        "citationsMin":{"type":"integer","minimum":0,"maximum":12},
        "absentText":{"type":"array","items":{"type":"string","minLength":1}}
      }
    },
    "condition":{
      "type":"object","additionalProperties":false,"required":["text"],
      "properties":{
        "text":{"type":"string","minLength":1,"maxLength":500},
        "type":{"enum":["custom","character_status","character_dead","not_unified"]},
        "characterId":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,63}$","description":"Must resolve to the shared content character registry; checked by the executable runner."},
        "status":{"enum":["normal","injured","critical"]},
        "knownToCurrent":{"type":"boolean"}
      },
      "allOf":[
        {"if":{"properties":{"type":{"const":"character_status"}},"required":["type"]},"then":{"required":["characterId","status"]}},
        {"if":{"properties":{"type":{"const":"character_dead"}},"required":["type"]},"then":{"required":["characterId"]}}
      ]
    },
    "step":{
      "type":"object","additionalProperties":false,"required":["action"],
      "properties":{
        "action":{"enum":["open","adopt","chat","switch","continue","inspect","denyAccess","cancelChat","failureProbe"]},
        "as":{"$ref":"#/$defs/alias"},"on":{"$ref":"#/$defs/alias"},"from":{"$ref":"#/$defs/alias"},"visitor":{"$ref":"#/$defs/alias"},
        "chapterId":{"type":"string","minLength":1},"sceneId":{"type":"string","minLength":1},
        "text":{"type":"string","minLength":1,"maxLength":2000},"request":{"type":"string","minLength":1,"maxLength":80},
        "condition":{"$ref":"#/$defs/condition"},"expect":{"$ref":"#/$defs/expect"},
        "operation":{"enum":["read","adopt","inherit"]}
      },
      "allOf":[
        {"if":{"properties":{"action":{"const":"open"}}},"then":{"required":["as","chapterId","sceneId"]}},
        {"if":{"properties":{"action":{"const":"switch"}}},"then":{"required":["from","as","sceneId"]}},
        {"if":{"properties":{"action":{"const":"continue"}}},"then":{"required":["from","as","chapterId","sceneId"]}},
        {"if":{"properties":{"action":{"enum":["adopt","chat","inspect","denyAccess","cancelChat","failureProbe"]}}},"then":{"required":["on"]}},
        {"if":{"properties":{"action":{"enum":["chat","cancelChat","failureProbe"]}}},"then":{"required":["text"]}},
        {"if":{"properties":{"action":{"const":"adopt"}}},"then":{"required":["condition"]}},
        {"if":{"properties":{"action":{"const":"denyAccess"}}},"then":{"required":["visitor","operation"]}}
      ]
    }
  }
}
