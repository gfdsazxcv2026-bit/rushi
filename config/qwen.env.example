# Qwen / Alibaba Cloud Bailian. Setup: configure-qwen.cmd.
# Copy the API Host from the SAME region as the API key.
# Example base URL pattern: https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Replace the workspace placeholder with the actual API Host. No automatic network calls.
MODEL_MODE=openai-compatible
MODEL_BASE_URL=
MODEL_NAME=qwen3.5-omni-plus
MODEL_API_KEY=
MODEL_TOKEN_PARAMETER=max_completion_tokens
MODEL_INSTRUCTION_ROLE=system
# Qwen3.5 Omni has no thinking mode. Leave this option blank.
MODEL_ENABLE_THINKING=
MODEL_OUTPUT_FORMAT=role-json
MODEL_TEMPERATURE=0.3
MODEL_PRESENCE_PENALTY=0
MODEL_TIMEOUT_MS=45000
MODEL_MAX_TOKENS=1000
MODEL_MAX_RETRIES=1
HOST=127.0.0.1
PORT=4317
DATA_DIR=./data
MAX_INPUT_CHARS=2000
VISITOR_REQUESTS_PER_MINUTE=12
DAILY_MODEL_REQUESTS=100
GLOBAL_DAILY_MODEL_REQUESTS=1000
