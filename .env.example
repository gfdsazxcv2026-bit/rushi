# 先使用明确标注的模拟模式。真实调用设置 MODEL_MODE=openai-compatible。
MODEL_MODE=mock
# 填所选提供商的兼容接口基址，不含 /chat/completions。
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT_MS=45000
MODEL_MAX_TOKENS=1000
# 按具体模型文档选择；不会自动换参数反复尝试收费请求。
MODEL_TOKEN_PARAMETER=max_tokens
MODEL_INSTRUCTION_ROLE=system
MODEL_MAX_RETRIES=1
# 可选供应商扩展。留空不发送；千问预设显式false。
MODEL_ENABLE_THINKING=
# 需由提供商支持JSON输出；通用接口默认保留text。
MODEL_OUTPUT_FORMAT=text
MODEL_TEMPERATURE=
MODEL_PRESENCE_PENALTY=
HOST=127.0.0.1
PORT=4317
DATA_DIR=./data
MAX_INPUT_CHARS=2000
VISITOR_REQUESTS_PER_MINUTE=12
DAILY_MODEL_REQUESTS=100
GLOBAL_DAILY_MODEL_REQUESTS=1000
