{
  "name": "rushi-demo",
  "version": "0.2.0-alpha.9",
  "private": true,
  "type": "module",
  "description": "入史：中文历史互动阅读的本地可验收 Demo",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --env-file-if-exists=.env --watch server/index.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "model:check": "node scripts/check-model.mjs",
    "dialogue:plan": "node scripts/evaluate-dialogue.mjs"
  }
}
